{
  "name": "portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Professional Full Stack Portfolio Monorepo (React 18 + Cloudflare Workers + Neon Postgres)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n \"api,web\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w portfolio-react",
    "dev:api": "npm run dev -w portfolio-worker",
    "dev:pages": "npm run dev:web",
    "dev:worker": "npm run dev:api",
    "build": "npm run build -w portfolio-worker && npm run build -w portfolio-react",
    "build:web": "npm run build -w portfolio-react",
    "build:api": "npm run build -w portfolio-worker",
    "build:all": "npm run build",
    "test": "npm run test -w portfolio-worker && npm run test -w portfolio-react",
    "test:web": "npm run test -w portfolio-react",
    "test:api": "npm run test -w portfolio-worker",
    "lint": "npm run lint -w portfolio-react",
    "clean": "rm -rf apps/web/dist apps/api/dist"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2"
  }
}
